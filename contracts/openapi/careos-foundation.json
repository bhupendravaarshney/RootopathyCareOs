{
  "openapi": "3.1.0",
  "info": {
    "title": "ROOTOPATHY CareOS Foundation API",
    "version": "0.6.0",
    "description": "Checked contract for the currently implemented public foundation, browser identity, and membership-backed organization-selection endpoints. Unsafe browser operations require an approved Origin or Referer plus the double-submit CSRF cookie/header pair."
  },
  "servers": [
    {
      "url": "http://localhost:8080"
    }
  ],
  "x-careos-conventions": {
    "tenantPathPrefix": "/api/v1/organizations/{organizationId}",
    "organizationParameter": "#/components/parameters/OrganizationId",
    "pagination": {
      "strategy": "cursor",
      "cursorParameter": "#/components/parameters/Cursor",
      "limitParameter": "#/components/parameters/Limit",
      "metadataSchema": "#/components/schemas/CursorPageMetadata",
      "clientTreatment": "opaque"
    },
    "filtering": {
      "mode": "operation-allow-list",
      "unknownParameters": "reject"
    },
    "optimisticConcurrency": {
      "responseHeader": "#/components/headers/ETag",
      "requestParameter": "#/components/parameters/IfMatch",
      "missingStatus": 428,
      "mismatchStatus": 412,
      "strongEtagsOnly": true
    },
    "idempotency": {
      "scope": "protected-tenant-mutations",
      "requestParameter": "#/components/parameters/IdempotencyKey",
      "requiredForCallerRetriedMutations": true,
      "keyReuseRequiresEquivalentRequest": true
    },
    "retry": {
      "policy": "caller-controlled",
      "retryableMethods": ["GET", "HEAD"],
      "statusCodes": [429, 503],
      "responseHeader": "#/components/headers/RetryAfter",
      "maximumDelaySeconds": 86400,
      "automaticMutationRetry": false
    },
    "sessionLifecycle": {
      "responseHeader": "#/components/headers/SessionExpiresIn",
      "refreshOnAuthenticatedRequest": true,
      "backgroundPolling": false,
      "clientDeadlineTreatment": "lock-without-refresh"
    }
  },
  "paths": {
    "/api/public/prototype-screens": {
      "get": {
        "operationId": "listPrototypeScreens",
        "responses": {
          "200": {
            "description": "All registered prototype screens",
            "headers": {
              "X-Correlation-Id": {
                "$ref": "#/components/headers/CorrelationId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PrototypeScreen"
                  }
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/api/public/system-summary": {
      "get": {
        "operationId": "getSystemSummary",
        "responses": {
          "200": {
            "description": "Foundation system summary",
            "headers": {
              "X-Correlation-Id": {
                "$ref": "#/components/headers/CorrelationId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemSummary"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/api/v1/auth/csrf": {
      "get": {
        "operationId": "issueCsrfToken",
        "description": "Creates or reuses an anonymous session, sets the readable XSRF-TOKEN cookie, and returns the matching raw token for an SPA request header.",
        "responses": {
          "200": {
            "description": "CSRF token issued",
            "headers": {
              "X-Correlation-Id": {
                "$ref": "#/components/headers/CorrelationId"
              },
              "Set-Cookie": {
                "description": "Contains the XSRF-TOKEN cookie.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CsrfToken"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/api/v1/auth/session": {
      "get": {
        "operationId": "getAuthenticationSession",
        "security": [
          {},
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Anonymous, pending-MFA, or fully authenticated session state",
            "headers": {
              "X-Correlation-Id": {
                "$ref": "#/components/headers/CorrelationId"
              },
              "X-CareOS-Session-Expires-In": {
                "$ref": "#/components/headers/SessionExpiresIn"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionState"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "operationId": "login",
        "parameters": [
          {
            "$ref": "#/components/parameters/BrowserOrigin"
          }
        ],
        "security": [
          {
            "csrfCookie": [],
            "csrfHeader": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/AuthenticatedSession"
          },
          "202": {
            "$ref": "#/components/responses/MfaPendingSession"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "logout",
        "parameters": [
          {
            "$ref": "#/components/parameters/BrowserOrigin"
          }
        ],
        "security": [
          {
            "sessionCookie": [],
            "csrfCookie": [],
            "csrfHeader": []
          }
        ],
        "responses": {
          "204": {
            "$ref": "#/components/responses/NoContent"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
