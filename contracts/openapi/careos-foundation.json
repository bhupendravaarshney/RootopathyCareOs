        "security": [
          {
            "sessionCookie": [],
            "csrfCookie": [],
            "csrfHeader": []
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/RecoveryCodes"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
